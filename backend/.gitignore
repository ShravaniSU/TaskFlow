# Environment and local secret files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependency and build output
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/

# Logs and local caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.vscode/
.idea/

# Terraform local state and providers
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
crash.log
crash.*.log

# Ansible local inventory can contain hosts, users, and key paths
ansible/inventory.ini
ansible/*.retry
