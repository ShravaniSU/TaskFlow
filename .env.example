# Docker image configuration
POSTGRES_IMAGE=postgres:16-alpine
BACKEND_IMAGE=taskflow/taskflow-backend:latest
FRONTEND_IMAGE=taskflow/taskflow-frontend:latest
NGINX_IMAGE=nginx:1.27-alpine

# Published and internal ports
HTTP_PORT=80
NGINX_PORT=80
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=80

# PostgreSQL credentials
POSTGRES_DB=taskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Backend application configuration
NODE_ENV=production
CORS_ORIGIN=http://localhost
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/taskflow?schema=public
